#version 330 core
// gfx::Canvas's one shader (src/gpu/gl_canvas.cpp): every fill and blit is a
// quad in screen pixels, origin top-left, y down -- SDL's coordinates.
layout(location = 0) in vec2 a_pos;
layout(location = 1) in vec2 a_uv;
layout(location = 2) in vec4 a_color;

uniform vec2 u_scale;  // 2 / target size

out vec2 v_uv;
out vec4 v_color;

void main() {
    v_uv = a_uv;
    v_color = a_color;
    gl_Position = vec4(a_pos.x * u_scale.x - 1.0, 1.0 - a_pos.y * u_scale.y, 0.0, 1.0);
}
